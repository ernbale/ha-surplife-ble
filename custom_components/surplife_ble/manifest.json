{
  "domain": "surplife_ble",
  "name": "Surplife BLE",
  "version": "0.3.1",
  "codeowners": [
    "@NathanBland"
  ],
  "config_flow": true,
  "dependencies": [
    "bluetooth_adapters",
    "media_source"
  ],
  "documentation": "https://github.com/ernbale/ha-surplife-ble",
  "issue_tracker": "https://github.com/ernbale/ha-surplife-ble/issues",
  "integration_type": "device",
  "iot_class": "local_polling",
  "requirements": [
    "bleak-retry-connector>=3.8.0"
  ],
  "bluetooth": [
    {
      "local_name": "IOTBT*",
      "connectable": true
    }
  ]
}
